# Copy to .env (git-ignored) and adjust. Never commit real values.
MERKLETRUST_ENV=development            # development | test | production

# Runtime data: SQLite database, quarantined uploads, job reports
# MERKLETRUST_DATA_DIR=data
# MERKLETRUST_DATABASE_URL=sqlite:///data/merkletrust.db

# ECDSA P-256 signing key (PKCS#8 PEM) kept OUTSIDE the repository.
# Create one with:  python -m scripts.generate_signing_key --out ~/.merkletrust/keys/signing.pem --encrypt
# If unset in development, a key is auto-created in ~/.merkletrust/keys/ (refused in production).
# MERKLETRUST_SIGNING_KEY_PATH=
# MERKLETRUST_SIGNING_KEY_PASSWORD=
# Directory of public keys (*.pem) of retired signing keys still accepted for verification.
# MERKLETRUST_TRUSTED_KEYS_DIR=

# API / server
# MERKLETRUST_CORS_ORIGINS=[]           # JSON list, e.g. ["https://dashboard.example"]; empty = same-origin only
# MERKLETRUST_MAX_UPLOAD_MB=100
# MERKLETRUST_SESSION_TTL_MINUTES=480
# MERKLETRUST_JOB_WORKERS=2
# MERKLETRUST_MAX_QUEUED_JOBS=20
# MERKLETRUST_ENABLE_DEMO=              # tamper/restore demo endpoints; default: on unless production
# MERKLETRUST_LOGIN_RATE_PER_MINUTE=10
# MERKLETRUST_UPLOAD_RATE_PER_MINUTE=20
# MERKLETRUST_LOG_LEVEL=INFO
# MERKLETRUST_LOG_JSON=true
