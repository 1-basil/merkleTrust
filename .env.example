# Copy to .env (git-ignored) and adjust. Never commit real values.
MERKLETRUST_ENV=development

# ECDSA P-256 signing key (PKCS#8 PEM) kept OUTSIDE the repository.
# Create one with:  python -m scripts.generate_signing_key --out ~/.merkletrust/keys/signing.pem --encrypt
# If unset in development, a key is auto-created in ~/.merkletrust/keys/ (refused in production).
# MERKLETRUST_SIGNING_KEY_PATH=
# MERKLETRUST_SIGNING_KEY_PASSWORD=

# Directory of public keys (*.pem) of retired signing keys still accepted for verification.
# MERKLETRUST_TRUSTED_KEYS_DIR=
