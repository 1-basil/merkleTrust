{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TamperReport",
  "type": "object",
  "required": [
    "job_id",
    "engine",
    "status",
    "findings",
    "role",
    "baseline_found",
    "baseline_job_id",
    "changed_chunks",
    "changed_files",
    "manifest_diff",
    "certificate_changed",
    "suspicious_targets"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "engine": { "type": "string", "enum": ["tamper"] },
    "status": { "type": "string", "enum": ["ok", "partial"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "title": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "role": { "type": "string", "enum": ["baseline", "comparison"] },
    "baseline_found": { "type": "boolean" },
    "baseline_job_id": { "type": ["string", "null"] },
    "changed_chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "old_hash", "new_hash"],
        "properties": {
          "index": { "type": "integer" },
          "old_hash": { "type": "string" },
          "new_hash": { "type": "string" }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change_type", "chunks"],
        "properties": {
          "path": { "type": "string" },
          "change_type": { "type": "string", "enum": ["modified", "added", "removed"] },
          "chunks": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "manifest_diff": {
      "type": "object",
      "required": ["permissions_added", "permissions_removed", "components_added", "components_removed"],
      "properties": {
        "permissions_added": { "type": "array", "items": { "type": "string" } },
        "permissions_removed": { "type": "array", "items": { "type": "string" } },
        "components_added": { "type": "array", "items": { "type": "string" } },
        "components_removed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "certificate_changed": { "type": "boolean" },
    "suspicious_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value", "reason"],
        "properties": {
          "type": { "type": "string", "enum": ["class", "service", "url"] },
          "value": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
