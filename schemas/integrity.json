{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntegrityReport",
  "type": "object",
  "required": [
    "job_id",
    "engine",
    "status",
    "findings",
    "sha256",
    "file_size",
    "chunk_size",
    "chunk_count",
    "chunks",
    "merkle_root",
    "tree_depth",
    "file_map"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "engine": { "type": "string", "enum": ["integrity"] },
    "status": { "type": "string", "enum": ["ok", "partial"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "title": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "sha256": { "type": "string" },
    "file_size": { "type": "integer", "minimum": 0 },
    "chunk_size": { "type": "integer", "minimum": 1 },
    "chunk_count": { "type": "integer", "minimum": 0 },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "offset", "length", "hash"],
        "properties": {
          "index": { "type": "integer" },
          "offset": { "type": "integer" },
          "length": { "type": "integer" },
          "hash": { "type": "string" }
        }
      }
    },
    "merkle_root": { "type": "string" },
    "tree_depth": { "type": "integer", "minimum": 0 },
    "file_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "offset", "length", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "offset": { "type": "integer" },
          "length": { "type": "integer" },
          "sha256": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
