{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoEntryReport",
  "type": "object",
  "required": [
    "job_id",
    "engine",
    "status",
    "findings",
    "entry_index",
    "canonical_report_sha256",
    "prev_entry_hash",
    "entry_hash",
    "signature",
    "pubkey_id",
    "repo_merkle_root",
    "inclusion_proof",
    "timestamp",
    "sim_block"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "engine": { "type": "string", "enum": ["repository"] },
    "status": { "type": "string", "enum": ["ok", "partial"] },
    "findings": { "type": "array" },
    "entry_index": { "type": "integer", "minimum": 0 },
    "canonical_report_sha256": { "type": "string" },
    "prev_entry_hash": { "type": "string" },
    "entry_hash": { "type": "string" },
    "signature": { "type": "string" },
    "pubkey_id": { "type": "string" },
    "repo_merkle_root": { "type": "string" },
    "inclusion_proof": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sibling", "position"],
        "properties": {
          "sibling": { "type": "string" },
          "position": { "type": "string", "enum": ["left", "right"] }
        }
      }
    },
    "timestamp": { "type": "string" },
    "sim_block": {
      "type": "object",
      "required": ["height", "block_hash", "tx_id", "simulated"],
      "properties": {
        "height": { "type": "integer" },
        "block_hash": { "type": "string" },
        "tx_id": { "type": "string" },
        "simulated": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}
